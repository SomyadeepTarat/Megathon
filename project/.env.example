GREENPRINT_CORS_ORIGINS=http://localhost:3000
GREENPRINT_PROPERTY_DATASET=london
VALUATION_BASELINE_MODEL_PATH=ml/models/london_snapshot.joblib
# Project-root .env loads automatically; explicit shell variables take precedence.
LLM_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_TIMEOUT_SECONDS=10
LLM_FALLBACK_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=20
# To run only local AI: LLM_PROVIDER=ollama and LLM_MODEL=qwen3:4b.
# To disable model calls: LLM_PROVIDER=deterministic.

# Omit this variable to use the bundled, sourced 2026 factors.
# An explicitly empty value disables carbon calculations.
GREENPRINT_EMISSION_FACTORS_FILE=Data/csv/emission_factors_2026.csv
